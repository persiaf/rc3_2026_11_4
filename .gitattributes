# Preserve original frozen bytes, including line endings.
* -text

# Frozen archives, training data and checkpoints use Git LFS.
*.zip filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text
rc3_rl_g2/outputs/training/ppo_episodes.jsonl filter=lfs diff=lfs merge=lfs -text

# S2 full legal-mask and trajectory journals exceed normal Git blob limits.
rc3_global_local_execution_v3/runs/rc3_v3_global_local_20261106_01/seed_*/RL/updates.jsonl filter=lfs diff=lfs merge=lfs -text

# S3 scope-r1 full event journals retain original bytes through Git LFS.
rc3_s3_connectivity_20261109/runs/rc3_v3_global_local_20261106_01/scope_r1/*/journal.jsonl filter=lfs diff=lfs merge=lfs -text

# Integrated-RPPO content-addressed full episodes and immutable event evidence.
