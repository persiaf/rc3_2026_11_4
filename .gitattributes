# Preserve original frozen bytes, including line endings.
* -text

# Frozen archives, training data and checkpoints use Git LFS.
*.zip filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text
rc3_rl_g2/outputs/training/ppo_episodes.jsonl filter=lfs diff=lfs merge=lfs -text

# S2 full legal-mask and trajectory journals exceed normal Git blob limits.
rc3_global_local_execution_v3/runs/rc3_v3_global_local_20261106_01/seed_*/RL/updates.jsonl filter=lfs diff=lfs merge=lfs -text

# S3 scope-r1 full event journals retain original bytes through Git LFS.
rc3_s3_connectivity_20261109/runs/rc3_v3_global_local_20261106_01/scope_r1/*/journal.jsonl filter=lfs diff=lfs merge=lfs -text

# Integrated-RPPO content-addressed full episodes and immutable event evidence.
rc3_integrated_rppo/runs/*/objects/*/*.json.gz filter=lfs diff=lfs merge=lfs -text
# The live append-only journal stays ordinary binary Git data. Applying the LFS
# clean filter during background UI diffs repeatedly copied each growing prefix.
rc3_integrated_rppo/runs/*/ledger/events.jsonl -filter -diff -merge -text

# R04-M2 new compact state evidence uses the existing LFS archive workflow.
rc3_r04_m2_20261111/**/M2_STATE_PREDICTIONS.csv.gz filter=lfs diff=lfs merge=lfs -text

# New frozen-reference online PG request and update evidence archives.
rc3_frozen_reference_pg_20261111/**/REQUESTS.jsonl.gz filter=lfs diff=lfs merge=lfs -text
rc3_frozen_reference_pg_20261111/**/ONLINE_UPDATE_DIAGNOSTICS.jsonl.gz filter=lfs diff=lfs merge=lfs -text

# New Actor-positive and conditionally triggered online evidence.
rc3_actor_positive_scale_20261111/**/*.jsonl.gz filter=lfs diff=lfs merge=lfs -text
